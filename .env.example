# Copy to backend_django/.env and fill the private database and Groq credentials.
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=false
DJANGO_PRODUCTION=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_PROXY_SSL_HEADER=false
DJANGO_API_URL=http://127.0.0.1:8000/api
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

DB_ENGINE=postgresql
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require
